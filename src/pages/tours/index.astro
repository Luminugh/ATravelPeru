---
import AppLayout from "../../layouts/AppLayout.astro";
import { tourUseCases } from "../../infrastructure/composition";
import type { Tour } from "../../domain/models";
import { toursPageConfig } from "../../lib/site-config";
import { optimizedImageUrl, responsiveImageSrcSet } from "../../lib/images";

let tours: Tour[] = [];
let hasLoadError = false;

try {
  tours = await tourUseCases.getCatalog.execute();
} catch {
  hasLoadError = true;
}

const experienceCount = String(tours.length).padStart(2, "0");
---

<AppLayout title={toursPageConfig.title}>
  <main class="tours-catalog-page">
    <div class="tours-catalog-shell">
      <section class="tours-intro" aria-labelledby="tours-heading">
        <div class="tours-intro-copy">
          <p class="tours-kicker"><span aria-hidden="true"></span> Viajes que se sienten distintos</p>
          <h1 id="tours-heading">El Perú empieza <span>por aquí.</span></h1>
          <p class="tours-intro-text">
            Rutas escogidas para mirar más lejos, descubrir nuevos sabores y llevarte historias que sí dan ganas de contar.
          </p>
          <a class="tours-explore-link" href="#tours-content">
            Explorar experiencias <span aria-hidden="true">↓</span>
          </a>
        </div>

        <aside class="tours-intro-glass" aria-label="Resumen del catálogo">
          <span class="tours-glass-orbit tours-glass-orbit-one" aria-hidden="true"></span>
          <span class="tours-glass-orbit tours-glass-orbit-two" aria-hidden="true"></span>
          <p class="tours-glass-label">Tu próxima historia</p>
          <div class="tours-glass-count"><span>{experienceCount}</span><span>experiencias</span></div>
          <p class="tours-glass-note">Naturaleza, cultura y aventura. A tu manera.</p>
          <a href="#tours-content" aria-label="Ver todas las experiencias">Ver el catálogo <span aria-hidden="true">↘</span></a>
        </aside>
      </section>

      <section id="tours-content" class="tours-catalog-section" aria-labelledby="catalog-heading">
        <header class="tours-section-heading">
          <div>
            <p class="tours-section-label">Elige tu próxima escapada</p>
            <h2 id="catalog-heading">Experiencias para recordar</h2>
          </div>
          <p class="tours-section-count"><span>{experienceCount}</span> rutas disponibles</p>
        </header>

        {tours.length === 0 ? (
          <div class="tours-empty-state" role={hasLoadError ? "alert" : undefined}>
            <span class="tours-empty-mark" aria-hidden="true">✳</span>
            <h3>{hasLoadError ? "Estamos preparando la ruta" : "Pronto habrá nuevas rutas"}</h3>
            <p>{hasLoadError ? "No pudimos cargar el catálogo en este momento. Vuelve a intentarlo en unos minutos." : "Estamos preparando experiencias nuevas para que encuentres tu próximo destino."}</p>
            {hasLoadError && <a href="/tours">Intentar de nuevo</a>}
          </div>
        ) : (
          <div class="tours-prism-grid">
            {tours.map((tour, index) => (
              <article class="tours-prism-card" data-prism-card>
                <div class="tours-prism-image-wrap">
                  {tour.imagen_principal && (
                    <img
                      class="tours-prism-image"
                      src={optimizedImageUrl(tour.imagen_principal, 480, { quality: 58 })}
                      srcset={responsiveImageSrcSet(tour.imagen_principal, { quality: 58 })}
                      sizes="(max-width: 680px) calc(100vw - 40px), (max-width: 1100px) calc(50vw - 32px), 380px"
                      alt={tour.titulo}
                      width="800"
                      height="560"
                      decoding="async"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                    />
                  )}
                  <div class="tours-prism-image-shade" aria-hidden="true"></div>
                  <div class="tours-prism-badges">
                    {tour.destacado && <span class="tours-prism-badge tours-prism-featured">Recomendado</span>}
                    <span class={`tours-prism-badge tours-prism-status ${tour.estado === "activo" ? "is-active" : "is-inactive"}`}>
                      {tour.estado === "activo" ? "Disponible" : "No disponible"}
                    </span>
                  </div>
                  <span class="tours-prism-image-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                </div>

                <div class="tours-prism-content">
                  <p class="tours-prism-location">{tour.ubicacion} <span aria-hidden="true">/</span> {tour.duracion}</p>
                  <h3>{tour.titulo}</h3>
                  <p class="tours-prism-description">{tour.descripcion}</p>
                  <footer class="tours-prism-footer">
                    <div class="tours-prism-price">
                      <span>Desde</span>
                      <strong>{tour.precio}</strong>
                    </div>
                    {tour.estado === "activo" ? (
                      <a class="tours-prism-link" href={`/tours/${tour.id}`} aria-label={`Ver detalles de ${tour.titulo}`}>
                        Descubrir <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span class="tours-prism-unavailable">No disponible</span>
                    )}
                  </footer>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <section class="tours-values" aria-label="Lo que hace especial cada viaje">
        {toursPageConfig.whyChooseCards.slice(0, 3).map((item) => (
          <article class="tours-value-card">
            <span class="tours-value-icon" aria-hidden="true"><i class={item.title === "100% Asegurado" ? "fas fa-shield-halved" : item.icon}></i></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>

  <script>
    const supportsFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (supportsFinePointer.matches && !prefersReducedMotion.matches) {
      document.querySelectorAll<HTMLElement>("[data-prism-card]").forEach((card) => {
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;

        card.addEventListener("pointermove", (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (frame) return;

          frame = requestAnimationFrame(() => {
            const bounds = card.getBoundingClientRect();
            const x = Math.max(0, Math.min(1, (pointerX - bounds.left) / bounds.width));
            const y = Math.max(0, Math.min(1, (pointerY - bounds.top) / bounds.height));
            card.style.setProperty("--prism-x", `${Math.round(pointerX - bounds.left)}px`);
            card.style.setProperty("--prism-y", `${Math.round(pointerY - bounds.top)}px`);
            card.style.setProperty("--prism-tilt-x", `${((x - 0.5) * 3).toFixed(2)}deg`);
            card.style.setProperty("--prism-tilt-y", `${((0.5 - y) * 3).toFixed(2)}deg`);
            frame = 0;
          });
        }, { passive: true });

        card.addEventListener("pointerleave", () => {
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
          card.style.setProperty("--prism-tilt-x", "0deg");
          card.style.setProperty("--prism-tilt-y", "0deg");
        }, { passive: true });
      });
    }
  </script>
</AppLayout>
