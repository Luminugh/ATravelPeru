---
import AppLayout from "../layouts/AppLayout.astro";
import { siteIdentity } from "../lib/site-config";
import cachedTours from "../data/tours-cache.json";
import { optimizedImageUrl, responsiveImageSrcSet } from "../lib/images";

export const prerender = true;
const tours = cachedTours as Array<{ id: number; titulo: string; descripcion: string; precio: string; duracion: string; ubicacion: string; imagen_principal: string; destacado?: boolean; estado?: string }>;
const featuredTours = [...tours.filter((tour) => tour.estado === "activo" && tour.destacado), ...tours.filter((tour) => tour.estado === "activo" && !tour.destacado)].slice(0, 3);
---

<AppLayout title={siteIdentity.appTitleDefault}>
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <img class="home-hero-photo" src="/assets/images/home/peru-hero-optimized.webp" alt="Ciudadela inca de Machu Picchu rodeada por montañas" width="1350" height="900" fetchpriority="high" decoding="async" />
      <div class="home-hero-shade" aria-hidden="true"></div>
      <div class="home-hero-copy">
        <p class="home-eyebrow"><span></span> Viajes con raíz peruana</p>
        <h1 id="home-title">El Perú se<br />vive <em>de cerca.</em></h1>
        <p class="home-lede">Paisajes que te cambian el ritmo, sabores que cuentan historias y rutas preparadas con cuidado, para que tú solo tengas que estar ahí.</p>
        <div class="home-actions">
          <a class="home-button home-button-primary" href="/tours#tours-content">Encuentra tu viaje <span aria-hidden="true">↗</span></a>
          <button class="home-button home-button-glass" id="hero-video-toggle" type="button" aria-controls="hero-video" aria-pressed="false"><span class="play-icon" aria-hidden="true">▶</span> Ver el paisaje en movimiento</button>
        </div>
        <div class="home-proofline"><span>Rutas seleccionadas</span><i></i><span>Atención cercana</span><i></i><span>Información clara</span></div>
      </div>
      <div class="home-hero-caption"><span>13° 09′ 47″ S</span><span>VALLE SAGRADO · CUSCO</span></div>
      <video id="hero-video" class="home-video" width="1280" height="720" muted loop playsinline preload="none" poster="/assets/images/home/peru-hero-optimized.webp" aria-hidden="true">
        <source data-src="/assets/videos/Video1.mp4" type="video/mp4" />
      </video>
      <p class="home-video-caption" id="video-caption" hidden>Video activo <button type="button" id="hero-video-stop">Pausar</button></p>
      <a class="home-scroll" href="#experiencias">Desliza para explorar <span aria-hidden="true">↓</span></a>
      <div class="home-hero-stamp" aria-hidden="true"><span>Hecho para</span><strong>descubrir</strong><i>PERÚ · 2026</i></div>
    </section>

    <div class="home-ribbon" aria-label="Lo que encontrarás con ATravel">
      <span>Montaña</span><b>✳</b><span>Historia viva</span><b>✳</b><span>Sabores locales</span><b>✳</b><span>Rutas con sentido</span><b>✳</b><span>Naturaleza</span>
    </div>

    <section class="home-section home-featured" id="experiencias" aria-labelledby="featured-title">
      <header class="section-heading">
        <div><p class="home-eyebrow">Elige tu próximo recuerdo</p><h2 id="featured-title">Rutas para <em>sentir.</em></h2></div>
        <a class="home-text-link" href="/tours#tours-content">Ver todas las experiencias <span aria-hidden="true">↗</span></a>
      </header>
      <div class="featured-grid">
        {featuredTours.map((tour, index) => (
          <a class:list={["featured-card", { "featured-card--lead": index === 0 }]} href={`/tours/${tour.id}`}>
            <img src={optimizedImageUrl(tour.imagen_principal, 760, { quality: 72 })} srcset={responsiveImageSrcSet(tour.imagen_principal, { quality: 72 })} sizes={index === 0 ? "(max-width: 760px) 100vw, 58vw" : "(max-width: 760px) 100vw, 30vw"} alt={tour.titulo} width="760" height="560" loading="lazy" decoding="async" />
            <span class="featured-index">0{index + 1} / EXPERIENCIA</span>
            <div class="featured-shade"></div>
            <div class="featured-content"><p>{tour.ubicacion} <span>·</span> {tour.duracion}</p><h3>{tour.titulo}</h3><div class="featured-bottom"><span>Desde <strong>{tour.precio}</strong></span><span class="featured-arrow" aria-hidden="true">↗</span></div></div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-story" aria-labelledby="story-title">
      <div class="story-visual">
        <img src="/assets/images/home/peru-andes.webp" alt="Cordillera andina entre valles verdes y montañas" width="1200" height="800" loading="lazy" decoding="async" />
        <div class="story-photo-note"><span>01 —</span><span>Un lugar se recuerda<br />por cómo te hizo sentir.</span></div>
        <div class="story-orbit" aria-hidden="true"></div>
      </div>
      <div class="story-copy"><p class="home-eyebrow">Más que llegar al destino</p><h2 id="story-title">El viaje empieza<br />cuando <em>te conectas.</em></h2><p>Queremos que conozcas cada lugar con tiempo, curiosidad y respeto. Por eso seleccionamos rutas con espacio para mirar, conversar y dejarte sorprender.</p><p>Te ayudamos a elegir la experiencia adecuada, compartimos la información que necesitas antes de salir y estamos disponibles para acompañarte durante el recorrido.</p><a class="home-text-link" href="/tours#tours-content">Conoce las experiencias <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="home-section home-values" aria-labelledby="values-title">
      <div class="values-intro"><p class="home-eyebrow">Viajar con tranquilidad</p><h2 id="values-title">Cuidado en cada<br /><em>parte del camino.</em></h2><p>Los buenos recuerdos también nacen de saber qué esperar y sentir que alguien está pendiente de los detalles.</p></div>
      <div class="values-list">
        <article><span>01</span><div><h3>Antes de salir</h3><p>Resolvemos tus dudas y te explicamos con claridad horarios, punto de encuentro, duración y lo que incluye la experiencia.</p></div></article>
        <article><span>02</span><div><h3>En ruta</h3><p>Una coordinación responsable te permite disfrutar el recorrido con menos preocupaciones y más tiempo para descubrir.</p></div></article>
        <article><span>03</span><div><h3>A tu regreso</h3><p>Nos importa cómo viviste el viaje. Tu experiencia nos ayuda a seguir cuidando cada detalle.</p></div></article>
      </div>
    </section>

    <section class="home-final-cta" aria-labelledby="cta-title"><p class="home-eyebrow">Hay un Perú esperándote</p><h2 id="cta-title">Vamos a encontrar<br /><em>tu próximo lugar.</em></h2><p>Explora el catálogo y empieza a imaginar el camino.</p><a class="home-button home-button-primary" href="/tours#tours-content">Explorar todos los tours <span aria-hidden="true">↗</span></a></section>
  </main>
  <script>
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    const videoButton = document.querySelector<HTMLButtonElement>("#hero-video-toggle");
    const caption = document.querySelector<HTMLElement>("#video-caption");
    video?.addEventListener("playing", () => video.classList.add("is-playing"));
    video?.addEventListener("pause", () => video.classList.remove("is-playing"));
    videoButton?.addEventListener("click", async () => {
      if (!video) return;
      const source = video.querySelector("source");
      if (source && !source.src) { source.src = source.dataset.src || ""; video.load(); }
      if (video.paused) { try { await video.play(); videoButton.setAttribute("aria-pressed", "true"); videoButton.innerHTML = '<span class="play-icon" aria-hidden="true">Ⅱ</span> Pausar video'; if (caption) caption.hidden = false; } catch { videoButton.textContent = "No se pudo reproducir el video"; } }
      else { video.pause(); videoButton.setAttribute("aria-pressed", "false"); videoButton.innerHTML = '<span class="play-icon" aria-hidden="true">▶</span> Ver el paisaje en movimiento'; if (caption) caption.hidden = true; }
    });
    document.querySelector<HTMLButtonElement>("#hero-video-stop")?.addEventListener("click", () => { video?.pause(); if (videoButton) { videoButton.innerHTML = '<span class="play-icon" aria-hidden="true">▶</span> Ver el paisaje en movimiento'; videoButton.setAttribute("aria-pressed", "false"); } if (caption) caption.hidden = true; });
  </script>
</AppLayout>

<style>
.home-page{--ink:var(--page);--atlantic:var(--surface);--glass:var(--surface-raised);--ice:var(--text-primary);--muted:var(--text-secondary);--tide:var(--accent);--violet:light-dark(#7357b1,#c2a5ff);background:var(--ink);color:var(--ice);overflow:hidden}.home-page *{box-sizing:border-box}.home-hero{position:relative;isolation:isolate;min-height:min(820px,calc(100svh - 76px));margin-top:76px;display:flex;align-items:center;padding:clamp(64px,9vw,118px) max(7.5vw,28px);overflow:hidden}.home-hero-photo,.home-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.home-hero-photo{object-position:center 46%}.home-hero-shade{position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(5,15,26,.97) 0%,rgba(5,15,26,.84) 34%,rgba(5,15,26,.28) 74%,rgba(5,15,26,.2)),linear-gradient(0deg,rgba(5,15,26,.78),transparent 35%,rgba(5,15,26,.15))}.home-video{z-index:-1;opacity:0;transition:opacity .55s}.home-video.is-playing{opacity:.62}.home-hero-copy{position:relative;z-index:2;max-width:710px}.home-eyebrow{display:flex;align-items:center;gap:10px;margin:0;color:var(--tide);font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:750}.home-eyebrow>span{width:7px;height:7px;background:var(--tide);border-radius:50%;box-shadow:0 0 16px var(--tide)}.home-hero h1{font-size:clamp(56px,8.2vw,112px);line-height:.91;letter-spacing:-.075em;margin:25px 0 21px;font-weight:720}.home-page em{font-family:Georgia,serif;color:var(--tide);font-weight:400;letter-spacing:-.065em}.home-hero .home-eyebrow,.home-hero em{color:#a7f5e8}.home-hero .home-eyebrow>span{background:#a7f5e8;box-shadow:0 0 16px #a7f5e8}.home-lede{max-width:530px;margin:0;color:#d0dbe5;font-size:clamp(16px,1.6vw,20px);line-height:1.65}.home-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:30px}.home-button{display:inline-flex;min-height:50px;align-items:center;justify-content:center;gap:12px;padding:0 19px;border-radius:13px;font:inherit;font-size:13px;font-weight:720;text-decoration:none;cursor:pointer;transition:transform .2s,background .2s,border-color .2s}.home-button:hover{transform:translateY(-2px)}.home-button-primary{color:var(--accent-contrast);background:linear-gradient(125deg,var(--accent),var(--accent-strong));border:1px solid var(--accent);box-shadow:0 12px 32px color-mix(in srgb,var(--accent) 18%,transparent)}.home-button-glass{color:var(--ice);border:1px solid #e1f1ff40;background:#ffffff12;backdrop-filter:blur(18px)}.play-icon{display:grid;place-items:center;width:26px;height:26px;border:1px solid #ffffff40;border-radius:50%;font-size:10px}.home-proofline{display:flex;align-items:center;gap:12px;margin-top:30px;color:#d6e2ec;font-size:11px;letter-spacing:.04em}.home-proofline i{width:3px;height:3px;border-radius:50%;background:var(--tide)}.home-hero-caption{position:absolute;right:max(7.5vw,28px);bottom:36px;display:flex;gap:18px;color:#eef7ffb5;font-size:9px;letter-spacing:.16em}.home-scroll{position:absolute;left:max(7.5vw,28px);bottom:34px;display:flex;gap:11px;align-items:center;color:#eef7ff;text-decoration:none;font-size:11px}.home-scroll span{color:var(--tide);font-size:18px}.home-hero-stamp{position:absolute;right:9%;top:20%;width:132px;height:132px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #ffffff40;border-radius:50%;background:#07132145;backdrop-filter:blur(14px);transform:rotate(8deg);color:#e4edf5}.home-hero-stamp span{font-size:10px;letter-spacing:.1em}.home-hero-stamp strong{font:italic 22px Georgia,serif;color:var(--tide)}.home-hero-stamp i{font-style:normal;font-size:8px;letter-spacing:.18em;margin-top:5px}.home-video-caption{position:absolute;right:7vw;bottom:78px;color:white;font-size:12px}.home-video-caption button{margin-left:8px;color:var(--tide);border:0;background:none;cursor:pointer}.home-ribbon{display:flex;justify-content:center;align-items:center;gap:clamp(14px,3vw,38px);min-height:62px;overflow:hidden;border-bottom:1px solid var(--border-color);background:var(--surface-soft);color:var(--text-secondary);white-space:nowrap;font-size:10px;letter-spacing:.16em;text-transform:uppercase}.home-ribbon b{color:var(--tide);font-size:13px}.home-section{width:min(1320px,100% - 56px);margin:auto;padding:clamp(78px,9vw,125px) 0}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:32px}.home-section h2,.story-copy h2,.values-intro h2,.home-final-cta h2{margin:14px 0 0;font-size:clamp(40px,5.3vw,68px);line-height:.99;letter-spacing:-.065em}.home-text-link{color:var(--tide);font-size:13px;font-weight:650;text-decoration:none;white-space:nowrap}.home-text-link span{margin-left:8px}.featured-grid{display:grid;grid-template-columns:1.55fr 1fr 1fr;gap:14px}.featured-card{position:relative;min-height:390px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;border:1px solid #e4f2ff22;border-radius:20px;background:#13283b;color:var(--ice);text-decoration:none;isolation:isolate}.featured-card img{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.2,.75,.25,1)}.featured-card:hover img{transform:scale(1.045)}.featured-shade{position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,#06111b6e,transparent 32%,#06111be8 100%)}.featured-index{margin:20px;color:#edf5f9;font-size:9px;letter-spacing:.16em}.featured-content{padding:20px}.featured-content>p{margin:0 0 8px;color:#d0e1e8;font-size:11px;letter-spacing:.06em}.featured-content>p span{color:var(--tide)}.featured-content h3{max-width:410px;margin:0;font-size:clamp(21px,2.4vw,31px);line-height:1.12;letter-spacing:-.04em}.featured-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding-top:13px;border-top:1px solid #ffffff3b;color:#e5edf1;font-size:11px}.featured-bottom strong{margin-left:6px;color:white;font-size:15px}.featured-arrow{display:grid;place-items:center;width:34px;height:34px;border:1px solid #d7f4ef75;border-radius:50%;color:var(--tide);font-size:17px}.featured-card--lead{min-height:460px}.home-story{display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(40px,8vw,110px);width:min(1320px,100% - 56px);margin:15px auto 30px;padding:36px 0 100px}.story-visual{position:relative;min-height:540px;border-radius:26px;overflow:hidden;background:#13283b}.story-visual>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}.story-visual:after{position:absolute;content:"";inset:0;background:linear-gradient(0deg,#071321b8,transparent 48%)}.story-photo-note{position:absolute;z-index:1;left:24px;bottom:24px;display:flex;gap:14px;align-items:start;color:white;font-family:Georgia,serif;font-size:17px;font-style:italic;line-height:1.35}.story-photo-note span:first-child{font:10px sans-serif;color:var(--tide);letter-spacing:.1em}.story-orbit{position:absolute;right:-24px;top:58px;width:130px;height:130px;border:1px solid #a2f4e46b;border-radius:50%;box-shadow:0 0 0 12px #83f0df12,0 0 0 24px #83f0df09}.story-copy>p:not(.home-eyebrow){max-width:520px;color:var(--muted);font-size:15px;line-height:1.85}.story-copy .home-text-link{display:inline-block;margin-top:15px}.home-values{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;border-top:1px solid #dcecff1a}.values-intro>p:last-child{max-width:420px;color:var(--muted);font-size:15px;line-height:1.75}.values-list article{display:grid;grid-template-columns:40px 1fr;gap:14px;padding:22px 0;border-bottom:1px solid #dcecff1a}.values-list article>span{color:var(--tide);font-size:11px}.values-list h3{margin:0 0 6px;font-size:17px}.values-list p{max-width:630px;margin:0;color:var(--muted);font-size:14px;line-height:1.7}.home-final-cta{width:min(1320px,100% - 56px);margin:0 auto 95px;padding:clamp(55px,8vw,100px) 25px;border:1px solid var(--border-color);border-radius:28px;text-align:center;background:radial-gradient(ellipse at 50% 0,var(--accent-soft),transparent 54%),var(--surface-glass)}.home-final-cta .home-eyebrow{justify-content:center}.home-final-cta>p:not(.home-eyebrow){margin:18px auto 25px;color:var(--muted);font-size:14px}.home-final-cta .home-button{margin:auto}
@media(max-width:760px){.home-hero{min-height:min(760px,calc(100svh - 68px));margin-top:68px;padding:78px 23px 100px;align-items:center}.home-hero-photo{object-position:59% center}.home-hero-shade{background:linear-gradient(90deg,#050f1af2,#050f1aa3 75%,#050f1a85),linear-gradient(0deg,#050f1abf,transparent 55%)}.home-hero h1{font-size:clamp(55px,14vw,78px)}.home-lede{max-width:450px;font-size:15px}.home-actions{align-items:stretch;flex-direction:column;max-width:345px}.home-button{width:100%}.home-proofline{gap:8px;flex-wrap:wrap;font-size:9px}.home-hero-stamp{width:90px;height:90px;right:20px;top:24px;opacity:.84}.home-hero-stamp strong{font-size:16px}.home-hero-caption{display:none}.home-section,.home-story,.home-values,.home-final-cta{width:calc(100% - 40px)}.section-heading{align-items:start;flex-direction:column;gap:16px}.featured-grid{grid-template-columns:1fr;gap:12px}.featured-card,.featured-card--lead{min-height:390px}.home-story{grid-template-columns:1fr;gap:32px;padding:15px 0 72px}.story-visual{min-height:400px}.story-copy h2,.home-values h2,.home-section h2,.home-final-cta h2{font-size:clamp(39px,10vw,54px)}.home-values{grid-template-columns:1fr;gap:28px;padding-top:65px}.home-final-cta{margin-bottom:60px}.home-ribbon{justify-content:flex-start;padding:0 20px}}
@media(prefers-reduced-motion:reduce){.home-button,.featured-card img{transition:none}}
</style>
