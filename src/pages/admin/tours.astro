---
import AdminLayout from "../../layouts/AdminLayout.astro";
import MediaPicker from "../../components/MediaPicker.astro";
import { siteIdentity } from "../../lib/site-config";

export const prerender = true;

const title = `Gestion de Tours AT - ${siteIdentity.adminTitleDefault}`;
---

<AdminLayout title={title}>
  <!-- Tours Section -->
  <section class="content-section">
    <div class="section-header section-header-spaced">
      <div>
        <h3><i class="fas fa-map"></i> Gestión de Tours AT</h3>
        <p id="tourCount" class="section-description">Cargando...</p>
      </div>
      <div class="section-actions">
        <button id="newBtn" class="btn btn-primary btn-lg"><i class="fas fa-plus"></i> Nuevo Tour</button>
      </div>
    </div>

    <!-- Controles de búsqueda y filtro mejorado -->
    <div class="tours-controls">
      <div class="search-row">
        <div class="search-input">
          <i class="fas fa-search"></i>
          <input id="searchInput" type="text" placeholder="Buscar por título o destino..." />
        </div>
        <select id="filterStatus" class="select-input">
          <option value="">Todos los estados</option>
          <option value="activo">Activo</option>
          <option value="inactivo">Inactivo</option>
        </select>
        <select id="filterDestino" class="select-input">
          <option value="">Todos los destinos</option>
        </select>
      </div>
    </div>

    <!-- Grid de tarjetas -->
    <div id="toursList" class="tours-grid"></div>

    <!-- Empty state -->
    <div id="emptyState" class="empty-state" style="display: none;">
      <i class="fas fa-inbox"></i>
      <p>No se encontraron tours</p>
      <p>Crea uno nuevo para empezar</p>
    </div>

    <!-- Modal overlay -->
    <div id="modalOverlay" class="modal-overlay" style="display: none;"></div>

    <!-- Edit modal refactorizado -->
    <div id="editor" class="tour-modal" style="display: none;">
      <div id="editorBackdrop" class="tour-modal-backdrop"></div>
      <div class="tour-modal-shell" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="tour-modal-header">
          <div class="tour-modal-heading">
            <span class="tour-modal-eyebrow">Gestión de tours</span>
            <h2 id="modalTitle">Nuevo Tour</h2>
            <p class="tour-modal-subtitle">Completa la información principal y navega por secciones rápidas sin perder el botón de guardar.</p>
          </div>
          <button type="button" id="closeBtn" class="tour-modal-close">&times;</button>
        </div>

        <form id="editorForm" class="tour-modal-form">
          <input type="hidden" name="id" />

          <div class="tour-modal-scroll">
            <div class="guide-note tour-flow-note">
              Organiza el tour en este orden: primero la información base, luego el contenido, y al final las imágenes y opciones de publicación.
            </div>

            <div class="tour-modal-grid">
              <div class="tour-column tour-column-main">
                <section class="tour-card-section" id="tour-basic">
                  <div class="section-heading">
                    <h3 class="section-title"><i class="fas fa-info-circle"></i> Información Básica</h3>
                    <p class="section-subtitle">Define lo esencial del tour para que el registro quede claro desde el inicio.</p>
                  </div>

                  <div class="tour-field">
                    <label><i class="fas fa-heading"></i> Título del Tour *</label>
                    <input name="titulo" required placeholder="Ej. Machu Picchu Express" />
                  </div>

                  <div class="tour-field">
                    <label><i class="fas fa-file-alt"></i> Descripción Corta *</label>
                    <textarea name="descripcion" rows="3" required placeholder="Describe brevemente el tour..."></textarea>
                  </div>

                  <div class="tour-grid-3">
                    <div class="tour-field tour-field-compact">
                      <label><i class="fas fa-coins"></i> Precio (S/) *</label>
                      <input type="number" step="0.01" name="precio" required placeholder="1200" />
                    </div>
                    <div class="tour-field tour-field-compact">
                      <label><i class="fas fa-hourglass-end"></i> Duración *</label>
                      <small class="field-note">Ejemplo: 3 días, 2 noches.</small>
                      <input name="duracion" required placeholder="Ej. 3 dias" />
                    </div>
                    <div class="tour-field tour-field-compact">
                      <label><i class="fas fa-location-dot"></i> Destino *</label>
                      <select name="ubicacion_id" required></select>
                    </div>
                  </div>
                </section>

                <section class="tour-card-section" id="tour-content">
                  <div class="section-heading">
                    <h3 class="section-title"><i class="fas fa-list"></i> Contenido del Tour</h3>
                    <p class="section-subtitle">Describe lo que el cliente recibe y cómo se desarrolla la experiencia día a día.</p>
                  </div>

                  <div class="tour-grid-2">
                    <div class="tour-field">
                      <label class="label-success"><i class="fas fa-check-circle"></i> Incluye *</label>
                        <textarea name="incluye" rows="4" placeholder="- Transporte\n- Entradas\n- Guía profesional"></textarea>
                    </div>
                    <div class="tour-field">
                      <label class="label-danger"><i class="fas fa-times-circle"></i> No Incluye</label>
                      <textarea name="no_incluye" rows="4" placeholder="- Seguro\n- Gastos personales\n- Propinas"></textarea>
                    </div>
                  </div>

                  <div class="tour-field">
                    <label><i class="fas fa-route"></i> Descripción día a día</label>
                    <small class="field-note">Divide el texto por días para que el usuario entienda el flujo del tour.</small>
                    <textarea name="itinerario" rows="5" placeholder="Día 1: llegada y traslado\nDía 2: actividad principal\nDía 3: retorno"></textarea>
                  </div>
                </section>
              </div>

              <div class="tour-column tour-column-side">
                <section class="tour-card-section tour-card-section-media" id="tour-image">
                  <div class="section-heading">
                    <h3 class="section-title"><i class="fas fa-image"></i> Imagen Principal</h3>
                    <p class="section-subtitle">Escoge la portada primero para que el tour tenga una referencia visual clara.</p>
                  </div>

                  <div class="image-selector-container">
                    <div id="imagenPrincipalPreview" class="image-preview-large" style="display: none;">
                      <img id="previewImg" alt="Imagen principal del tour" />
                      <div class="image-preview-overlay">
                        <button type="button" id="changePrimaryBtn" class="btn btn-secondary btn-sm">Cambiar</button>
                        <button type="button" id="removePrimaryBtn" class="btn btn-danger btn-sm">Eliminar</button>
                      </div>
                    </div>

                    <div id="imagenPrincipalEmpty" class="image-placeholder">
                      <i class="fas fa-cloud-upload-alt"></i>
                      <p>Sin imagen seleccionada</p>
                      <p class="text-muted">Selecciona una imagen de tu biblioteca</p>
                    </div>

                    <input type="hidden" id="imagenPrincipalInput" name="imagen_principal" />
                    <button type="button" id="selectPrimaryBtn" class="btn btn-primary btn-block">
                      <i class="fas fa-plus"></i> Seleccionar Imagen Principal
                    </button>
                  </div>
                </section>

                <section class="tour-card-section tour-card-section-gallery" id="tour-gallery">
                  <div class="section-heading">
                    <h3 class="section-title"><i class="fas fa-images"></i> Galería de Fotos</h3>
                    <p class="section-subtitle">Agrega varias imágenes para vender mejor el tour sin saturar la pantalla principal.</p>
                  </div>

                  <div class="gallery-manager-container">
                    <div id="galeriaGrid" class="gallery-grid">
                      <!-- Las imágenes se renderizarán aquí dinámicamente -->
                    </div>

                    <div id="galeriaEmpty" class="gallery-empty" style="display: none;">
                      <i class="fas fa-image"></i>
                      <p>Sin fotos agregadas</p>
                      <p class="text-muted">Comienza agregando fotos a la galería</p>
                    </div>

                    <button type="button" id="addGalleryBtn" class="btn btn-primary btn-block">
                      <i class="fas fa-plus"></i> Agregar Foto a la Galería
                    </button>

                    <!-- Hidden textarea para guardar JSON -->
                    <textarea id="galeriaTextarea" name="galeria" style="display: none;"></textarea>
                  </div>
                </section>

                <section class="tour-card-section tour-card-section-tight" id="tour-options">
                  <div class="section-heading">
                    <h3 class="section-title"><i class="fas fa-cog"></i> Publicación</h3>
                    <p class="section-subtitle">Define si el tour se destacará en portada y si estará visible para el público.</p>
                  </div>

                  <div class="tour-options-row">
                    <label class="checkbox-inline">
                      <input type="checkbox" name="destacado" />
                      <span><i class="fas fa-star label-warning"></i> Destacado en portada</span>
                    </label>
                  </div>

                  <div class="tour-field">
                    <label>Estado de Publicación</label>
                    <div class="radio-group">
                      <label class="radio-inline">
                        <input type="radio" name="estado" value="activo" checked />
                        <span><i class="fas fa-eye"></i> Activo</span>
                      </label>
                      <label class="radio-inline">
                        <input type="radio" name="estado" value="inactivo" />
                        <span><i class="fas fa-eye-slash"></i> Inactivo</span>
                      </label>
                    </div>
                  </div>
                </section>
              </div>
            </div>
          </div>

          <div class="tour-modal-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Tour</button>
            <button type="button" id="cancelBtn" class="btn btn-secondary"><i class="fas fa-times"></i> Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <!-- Media Picker Modal -->
    <MediaPicker />
  </section>

    <script type="module">
      const api = {
        list: () => fetch('/api/admin/tours').then(r=>r.json()),
        create: (payload) => fetch('/api/admin/tours', { method: 'POST', headers:{'content-type':'application/json'}, body: JSON.stringify(payload)}).then(r=>r.json()),
        update: (payload) => fetch('/api/admin/tours', { method: 'PUT', headers:{'content-type':'application/json'}, body: JSON.stringify(payload)}).then(r=>r.json()),
        del: (id) => fetch('/api/admin/tours', { method: 'DELETE', headers:{'content-type':'application/json'}, body: JSON.stringify({id})}).then(r=>r.json()),
        ubicaciones: () => fetch('/api/admin/ubicaciones').then(r=>r.json()),
      };

      const listEl = document.getElementById('toursList');
      const emptyEl = document.getElementById('emptyState');
      const editor = document.getElementById('editor');
      const editorBackdrop = document.getElementById('editorBackdrop');
      const modalOverlay = document.getElementById('modalOverlay');
      const form = document.getElementById('editorForm');
      const newBtn = document.getElementById('newBtn');
      const cancelBtn = document.getElementById('cancelBtn');
      const closeBtn = document.getElementById('closeBtn');
      const searchInput = document.getElementById('searchInput');
      const filterStatus = document.getElementById('filterStatus');
      const filterDestino = document.getElementById('filterDestino');
      const tourCount = document.getElementById('tourCount');
      const tourModalScroll = document.querySelector('.tour-modal-scroll');

      let bodyScrollLockCount = 0;
      let previousBodyOverflow = '';

      function lockBodyScroll() {
        if (bodyScrollLockCount === 0) {
          previousBodyOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
        }
        bodyScrollLockCount += 1;
      }

      function unlockBodyScroll() {
        bodyScrollLockCount = Math.max(0, bodyScrollLockCount - 1);
        if (bodyScrollLockCount === 0) {
          document.body.style.overflow = previousBodyOverflow;
        }
      }

      let tours = [];
      let ubicaciones = [];

      function formatSoles(value) {
        const numericValue = Number(value ?? 0);
        if (!Number.isFinite(numericValue)) {
          return 'S/ 0.00';
        }

        return `S/ ${numericValue.toLocaleString('es-PE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })}`;
      }

      async function load() {
        const [tRes, uRes] = await Promise.all([api.list(), api.ubicaciones()]);
        if (uRes.ok) ubicaciones = uRes.data;
        if (tRes.ok) tours = tRes.data;
        populateUbicaciones();
        populateFilterDestino();
        applyFilters();
      }

      function applyFilters() {
        const searchTerm = searchInput.value.toLowerCase();
        const statusTerm = filterStatus.value;
        const destinoTerm = filterDestino.value;

        const filtered = tours.filter(t => {
          const matchSearch = !searchTerm || t.titulo.toLowerCase().includes(searchTerm) || t.ubicacion?.toLowerCase().includes(searchTerm);
          const matchStatus = !statusTerm || t.estado === statusTerm;
          const matchDestino = !destinoTerm || t.ubicacion_id == destinoTerm;
          return matchSearch && matchStatus && matchDestino;
        });

        tourCount.textContent = `${filtered.length} tour${filtered.length !== 1 ? 's' : ''} encontrado${filtered.length !== 1 ? 's' : ''}`;
        renderList(filtered);
      }

      function renderList(items) {
        if (items.length === 0) {
          listEl.style.display = 'none';
          emptyEl.style.display = 'block';
          return;
        }
        listEl.style.display = 'grid';
        emptyEl.style.display = 'none';

        listEl.innerHTML = items.map(t => {
          const statusText = t.estado === 'activo' ? 'Activo' : 'Inactivo';
          return `
            <div class="tour-card">
              <div class="tour-card-media">
                ${t.imagen_principal ? `<img src="${t.imagen_principal}" alt="${t.titulo}" />` : ''}
                <div class="tour-card-badge status ${t.estado}"><i class="fas ${t.estado === 'activo' ? 'fa-check-circle' : 'fa-times-circle'}"></i> ${statusText}</div>
                ${t.destacado ? `<div class="tour-card-badge featured"><i class="fas fa-star"></i></div>` : ''}
              </div>
              <div class="tour-card-body">
                <h4 class="tour-card-title">${t.titulo}</h4>
                <div class="tour-card-meta"><i class="fas fa-map-marker-alt"></i> ${t.ubicacion} <span>•</span> <i class="fas fa-clock"></i> ${t.duracion}</div>
                <div class="tour-card-price">${formatSoles(t.precio)}</div>
                <p class="tour-card-desc">${t.descripcion?.slice(0,100) ?? ''}...</p>
                <div class="tour-card-actions">
                  <button data-id="${t.id}" class="editBtn btn-edit"><i class="fas fa-edit"></i> Editar</button>
                  <button data-id="${t.id}" class="delBtn btn-delete"><i class="fas fa-trash"></i> Eliminar</button>
                </div>
              </div>
            </div>
          `;
        }).join('');

        listEl.querySelectorAll('.editBtn').forEach(b=>b.addEventListener('click', ()=>openEditor(b.dataset.id)));
        listEl.querySelectorAll('.delBtn').forEach(b=>b.addEventListener('click', ()=>delItem(b.dataset.id)));
      }

      function populateUbicaciones() {
        const sel = form.querySelector('select[name="ubicacion_id"]');
        sel.innerHTML = ubicaciones.map(u=>`<option value="${u.id}">${u.nombre}</option>`).join('');
      }

      function populateFilterDestino() {
        const sel = filterDestino;
        sel.innerHTML = '<option value="">Todos los destinos</option>' + ubicaciones.map(u=>`<option value="${u.id}">${u.nombre}</option>`).join('');
      }

      function openEditor(id) {
        const data = tours.find(t=>String(t.id)===String(id)) || {};
        const modalTitle = document.getElementById('modalTitle');
        modalTitle.textContent = data.id ? `Editar: ${data.titulo}` : 'Nuevo Tour';

        form.querySelector('input[name="id"]').value = data.id || '';
        form.querySelector('input[name="titulo"]').value = data.titulo || '';
        form.querySelector('textarea[name="descripcion"]').value = data.descripcion || '';
        form.querySelector('input[name="precio"]').value = data.precio ?? '';
        form.querySelector('input[name="duracion"]').value = data.duracion || '';
        form.querySelector('select[name="ubicacion_id"]').value = data.ubicacion_id || (ubicaciones[0]?.id ?? '');
        form.querySelector('textarea[name="incluye"]').value = data.incluye || '';
        form.querySelector('textarea[name="no_incluye"]').value = data.no_incluye || '';
        form.querySelector('textarea[name="itinerario"]').value = data.itinerario || '';
        form.querySelector('input[name="imagen_principal"]').value = data.imagen_principal || '';
        form.querySelector('textarea[name="galeria"]').value = JSON.stringify(data.galeria ?? [], null, 2);
        form.querySelector('input[name="destacado"]').checked = !!data.destacado;
        const estadoVal = data.estado || 'activo';
        form.querySelector(`input[name="estado"][value="${estadoVal}"]`).checked = true;
        openModal();
      }

      function openModal() {
        editor.style.display = 'flex';
        lockBodyScroll();
        tourModalScroll?.scrollTo({ top: 0, behavior: 'auto' });
        updateImagePreview(document.getElementById('imagenPrincipalInput').value);
        loadGalleryFromForm();
        wireAutosize();
      }

      function closeModal() {
        editor.style.display = 'none';
        unlockBodyScroll();
      }

      async function delItem(id) {
        if (!confirm('¿Estás seguro de que deseas eliminar este tour?')) return;
        const res = await api.del(Number(id));
        if (res.ok) await load(); else alert(res.error || 'Error al eliminar');
      }

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const idVal = form.querySelector('input[name="id"]').value;
        const estadoRadio = Array.from(form.querySelectorAll('input[name="estado"]')).find(r => r.checked);
        const payload = {
          id: idVal ? Number(idVal) : undefined,
          titulo: form.querySelector('input[name="titulo"]').value,
          descripcion: form.querySelector('textarea[name="descripcion"]').value,
          precio: Number(form.querySelector('input[name="precio"]').value || 0),
          duracion: form.querySelector('input[name="duracion"]').value,
          ubicacion_id: Number(form.querySelector('select[name="ubicacion_id"]').value),
          incluye: form.querySelector('textarea[name="incluye"]').value,
          no_incluye: form.querySelector('textarea[name="no_incluye"]').value || null,
          itinerario: form.querySelector('textarea[name="itinerario"]').value || null,
          imagen_principal: form.querySelector('input[name="imagen_principal"]').value || null,
          destacado: form.querySelector('input[name="destacado"]').checked,
          estado: estadoRadio ? estadoRadio.value : 'activo',
        };
        try {
          payload.galeria = JSON.parse(form.querySelector('textarea[name="galeria"]').value || '[]');
        } catch (e) {
          alert('Error: Galería JSON inválido - ' + e.message);
          return;
        }

        let res;
        if (payload.id) {
          res = await api.update(payload);
        } else {
          res = await api.create(payload);
        }
        if (res.ok) { await load(); closeModal(); } else {
          alert('Error al guardar: ' + (res.error || 'Error desconocido'));
        }
      });

      newBtn.addEventListener('click', () => { 
        form.reset();
        form.querySelector('input[name="id"]').value = '';
        form.querySelector('textarea[name="galeria"]').value = '[]';
        openModal();
      });

      cancelBtn.addEventListener('click', closeModal);
      closeBtn.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', closeModal);
      editorBackdrop?.addEventListener('click', closeModal);
      editor.addEventListener('click', (e) => e.stopPropagation());

      function autoResizeTextarea(textarea) {
        if (!textarea) return;
        textarea.style.height = 'auto';
        textarea.style.height = `${Math.max(textarea.scrollHeight, 96)}px`;
      }

      function wireAutosize() {
        form.querySelectorAll('textarea').forEach((textarea) => {
          autoResizeTextarea(textarea);
          textarea.removeEventListener('input', textarea._autoResizeHandler);
          textarea._autoResizeHandler = () => autoResizeTextarea(textarea);
          textarea.addEventListener('input', textarea._autoResizeHandler);
        });
      }

      searchInput.addEventListener('input', applyFilters);
      filterStatus.addEventListener('change', applyFilters);
      filterDestino.addEventListener('change', applyFilters);

      // ==== IMAGE & GALLERY MANAGEMENT ====

      let galleryImages = [];
      let isEditingTour = false;

      function updateImagePreview(url) {
        const previewContainer = document.getElementById('imagenPrincipalPreview');
        const emptyContainer = document.getElementById('imagenPrincipalEmpty');
        const img = document.getElementById('previewImg');
        
        if (url && url.trim()) {
          img.src = url;
          previewContainer.style.display = 'block';
          emptyContainer.style.display = 'none';
          img.onerror = () => {
            previewContainer.style.display = 'none';
            emptyContainer.style.display = 'block';
          };
        } else {
          previewContainer.style.display = 'none';
          emptyContainer.style.display = 'block';
        }
      }

      function renderGalleryGrid() {
        const grid = document.getElementById('galeriaGrid');
        const empty = document.getElementById('galeriaEmpty');
        
        if (!grid) {
          console.error('❌ galeriaGrid no encontrado en DOM');
          return;
        }
        
        console.log('📸 renderGalleryGrid - imágenes:', galleryImages.length);
        
        if (galleryImages.length === 0) {
          grid.innerHTML = '';
          if (empty) empty.style.display = 'flex';
        } else {
          if (empty) empty.style.display = 'none';
          
          grid.innerHTML = galleryImages.map((img, idx) => {
            return `<div class="gallery-item" data-idx="${idx}">
              <img src="${img}" alt="Foto ${idx + 1}" />
              <button type="button" class="gallery-item-delete" data-idx="${idx}" onclick="deleteGalleryItem(${idx}); return false;">
                <i class="fas fa-times"></i>
              </button>
            </div>`;
          }).join('');
        }
      }

      window.deleteGalleryItem = function(idx) {
        console.log('🗑️ deleteGalleryItem llamado con index:', idx);
        removeFromGallery(idx);
      };

      function updateGalleryJSON() {
        const jsonArray = galleryImages.map((url, idx) => ({
          imagen: url,
          orden: idx + 1
        }));
        const textarea = document.getElementById('galeriaTextarea');
        if (textarea) {
          textarea.value = JSON.stringify(jsonArray, null, 2);
          console.log('💾 JSON galería actualizado:', jsonArray.length, 'fotos');
        }
      }

      function addToGallery(url) {
        if (!url || !url.trim()) {
          console.warn('⚠️ URL vacía');
          return;
        }
        
        if (galleryImages.includes(url)) {
          console.log('⚠️ Foto ya existe');
          return;
        }
        
        galleryImages.push(url);
        console.log('✅ Foto AGREGADA. Total:', galleryImages.length);
        
        updateGalleryJSON();
        renderGalleryGrid();
      }

      function removeFromGallery(index) {
        if (index < 0 || index >= galleryImages.length) {
          console.warn('⚠️ Index inválido:', index);
          return;
        }
        
        const removed = galleryImages[index];
        galleryImages.splice(index, 1);
        console.log('✅ Foto REMOVIDA. Total:', galleryImages.length);
        
        updateGalleryJSON();
        renderGalleryGrid();
      }

      function loadGalleryFromForm() {
        try {
          const textarea = document.getElementById('galeriaTextarea');
          const galeriaText = textarea ? textarea.value.trim() : '';
          
          if (!galeriaText || galeriaText === '[]') {
            galleryImages = [];
            console.log('📋 Galería vacía en textarea');
          } else {
            const parsed = JSON.parse(galeriaText);
            if (Array.isArray(parsed)) {
              galleryImages = parsed.map(it => it.imagen || it.url || '').filter(Boolean);
              console.log('📋 Galería cargada:', galleryImages.length, 'fotos');
            }
          }
        } catch (e) {
          console.error('❌ Error al parsear JSON:', e);
          galleryImages = [];
        }
        
        renderGalleryGrid();
      }

      // Media picker integration
      const mediaPicker = document.getElementById('mediaPicker');
      const mediaPickerBackdrop = document.getElementById('mediaPickerBackdrop');
      const mediaPickerContent = document.getElementById('mediaPickerContent');
      const mediaPickerClose = document.getElementById('mediaPickerClose');
      const mediaPickerSelect = document.getElementById('mediaPickerSelect');
      const mediaPickerCancel = document.getElementById('mediaPickerCancel');
      let mediaSelectionMode = 'single'; // 'single' or 'multiple'
      let selectedMedia = new Set();

      async function openMediaPicker(mode = 'single') {
        mediaSelectionMode = mode;
        selectedMedia = new Set();
        mediaPickerContent.innerHTML = 'Cargando...';
        mediaPicker.style.display = 'flex';
        lockBodyScroll();
        const res = await fetch('/api/admin/media');
        const payload = await res.json().catch(()=>({ok:false}));
        if (!payload?.ok) { mediaPickerContent.innerHTML = 'Error cargando medios'; return; }
        const items = payload.data || [];
        mediaPickerContent.innerHTML = items.map(i => `
          <div class="picker-item" data-id="${i.id}" data-url="${i.url}">
            <img src="${i.url}" alt="${i.alt_text || ''}" />
            <div class="picker-meta">${i.filename || ''}</div>
          </div>
        `).join('');

        mediaPickerContent.querySelectorAll('.picker-item').forEach(el=>{
          el.addEventListener('click', ()=>{
            const id = el.dataset.id; const url = el.dataset.url;
            if (mediaSelectionMode === 'single') {
              selectedMedia = new Set([JSON.stringify({id, url})]);
              // highlight
              mediaPickerContent.querySelectorAll('.picker-item').forEach(x=>x.classList.remove('selected'));
              el.classList.add('selected');
            } else {
              const key = JSON.stringify({id, url});
              if (selectedMedia.has(key)) { selectedMedia.delete(key); el.classList.remove('selected'); }
              else { selectedMedia.add(key); el.classList.add('selected'); }
            }
          });
        });
      }

      function closeMediaPicker() {
        mediaPicker.style.display = 'none';
        unlockBodyScroll();
      }

      mediaPickerClose?.addEventListener('click', closeMediaPicker);
      mediaPickerCancel?.addEventListener('click', closeMediaPicker);
      mediaPickerBackdrop?.addEventListener('click', closeMediaPicker);
      
      mediaPickerSelect?.addEventListener('click', ()=>{
        const arr = Array.from(selectedMedia).map(s=>JSON.parse(s));
        console.log('🎬 mediaPickerSelect - modo:', mediaSelectionMode, '- items:', arr.length);
        
        if (mediaSelectionMode === 'single' && arr[0]) {
          console.log('🖼️ Imagen principal seleccionada:', arr[0].url);
          document.getElementById('imagenPrincipalInput').value = arr[0].url;
          updateImagePreview(arr[0].url);
        } else if (mediaSelectionMode === 'multiple') {
          console.log('🖼️ Agregando', arr.length, 'foto(s) a galería');
          arr.forEach((it, i) => {
            if (it && it.url) {
              console.log(`  [${i}] ${it.url}`);
              addToGallery(it.url);
            }
          });
        }
        closeMediaPicker();
      });

      // Hook up buttons
      const selectPrimaryBtn = document.getElementById('selectPrimaryBtn');
      const changePrimaryBtn = document.getElementById('changePrimaryBtn');
      const removePrimaryBtn = document.getElementById('removePrimaryBtn');
      const addGalleryBtn = document.getElementById('addGalleryBtn');

      selectPrimaryBtn?.addEventListener('click', () => openMediaPicker('single'));
      changePrimaryBtn?.addEventListener('click', () => openMediaPicker('single'));
      removePrimaryBtn?.addEventListener('click', () => {
        document.getElementById('imagenPrincipalInput').value = '';
        updateImagePreview('');
      });
      addGalleryBtn?.addEventListener('click', () => openMediaPicker('multiple'));

      wireAutosize();
      loadGalleryFromForm();
      load();
    </script>
</AdminLayout>
