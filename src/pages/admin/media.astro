---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { siteIdentity } from "../../lib/site-config";

export const prerender = true;

const title = `Gestión de Multimedia - ${siteIdentity.adminTitleDefault}`;
---

<AdminLayout title={title}>
  <section class="content-section">
    <!-- Header Section -->
    <div class="section-header">
      <div class="header-content">
        <h3><i class="fas fa-photo-video"></i> Gestor de Medios</h3>
        <p>Sube, organiza y reutiliza imágenes para tus tours y contenido.</p>
      </div>
      <div class="header-actions">
        <button id="refreshBtn" class="btn btn-secondary refresh-btn">
          <i class="fas fa-sync-alt"></i> Actualizar
        </button>
      </div>
    </div>

    <!-- Upload Section -->
    <div class="upload-section">
      <div class="upload-card">
        <button id="uploadToggle" class="upload-header" type="button" aria-expanded="false" aria-controls="uploadBody">
          <h4><i class="fas fa-cloud-upload-alt"></i> Subir Nueva Imagen</h4>
          <i id="uploadToggleIcon" class="fas fa-chevron-down upload-toggle-icon" aria-hidden="true"></i>
        </button>
        <div id="uploadBody" class="upload-body is-collapsed">
          <form id="uploadForm" class="upload-form upload-form-local">
            <div class="form-row">
              <div id="fileDropzone" class="file-input-wrapper">
                <input id="fileInput" type="file" name="file" accept="image/*" hidden />
                <label for="fileInput" class="file-input-label" aria-label="Seleccionar o arrastrar imagen para subir">
                  <i class="fas fa-image"></i>
                  <span class="file-input-text">
                    <strong id="fileLabel">Seleccionar imagen...</strong>
                    <small>o arrastra y suelta el archivo aquí</small>
                  </span>
                </label>
              </div>
            </div>
            <div class="form-row">
              <input id="altInput" name="alt_text" type="text" placeholder="Texto alternativo (opcional)" class="form-input" />
            </div>
            <div class="form-row">
              <input id="tagsInput" name="tags" type="text" placeholder="Etiquetas (separadas por comas)" class="form-input" />
            </div>
            <div class="form-row">
              <button class="btn btn-primary btn-upload" type="submit">
                <i class="fas fa-upload"></i> Subir Imagen
              </button>
            </div>
          </form>
          <div class="upload-divider"></div>
          <form id="linkUploadForm" class="upload-form upload-form-link">
            <div class="link-upload-row">
              <label for="imageUrlInput" class="form-label">Agregar desde enlace directo</label>
              <input id="imageUrlInput" name="image_url" type="url" placeholder="https://ejemplo.com/imagen.jpg" class="form-input" />
              <p class="form-hint">Pega un enlace directo a una imagen para descargarla y guardarla en la biblioteca.</p>
            </div>
            <div class="form-row link-action-row">
              <button id="linkUploadBtn" class="btn btn-primary btn-upload btn-upload-link" type="submit" hidden>
                <i class="fas fa-link"></i> Agregar desde enlace
              </button>
            </div>
          </form>
          <div id="uploadStatus" class="upload-status"></div>
        </div>
      </div>
    </div>

    <!-- Media Grid -->
    <div class="media-section">
      <div class="media-header">
        <h4><i class="fas fa-images"></i> Biblioteca de Medios</h4>
        <div class="media-stats">
          <span id="mediaCount">0 imágenes</span>
        </div>
      </div>

      <div id="mediaGrid" class="media-grid"></div>

      <div id="emptyState" class="empty-state">
        <div class="empty-icon">
          <i class="fas fa-images"></i>
        </div>
        <h4>No hay imágenes aún</h4>
        <p>Sube tu primera imagen para comenzar a construir tu biblioteca de medios.</p>
      </div>
    </div>
  </section>

  <!-- Image Preview Modal -->
  <div id="imageModal" class="image-modal">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h4 id="modalTitle">Vista previa</h4>
        <button id="modalClose" class="modal-close">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <img id="modalImage" src="" alt="" />
        <div class="image-info">
          <div class="info-row">
            <span class="info-label">Nombre:</span>
            <span id="infoFilename"></span>
          </div>
          <div class="info-row">
            <span class="info-label">Tamaño:</span>
            <span id="infoSize"></span>
          </div>
          <div class="info-row">
            <span class="info-label">Tipo:</span>
            <span id="infoType"></span>
          </div>
          <div class="info-row">
            <span class="info-label">URL:</span>
            <input id="infoUrl" type="text" readonly class="url-input" />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button id="copyUrlBtn" class="btn btn-secondary">
          <i class="fas fa-copy"></i> Copiar URL
        </button>
        <button id="deleteBtn" class="btn btn-danger">
          <i class="fas fa-trash"></i> Eliminar
        </button>
      </div>
    </div>
  </div>

  <script type="module">
    async function fetchJson(url, options) {
      const response = await fetch(url, options);
      const contentType = response.headers.get('content-type') || '';
      const rawBody = await response.text();

      let body = null;
      if (rawBody && contentType.includes('application/json')) {
        try {
          body = JSON.parse(rawBody);
        } catch {
          body = null;
        }
      } else if (rawBody) {
        try {
          body = JSON.parse(rawBody);
        } catch {
          body = { raw: rawBody };
        }
      }

      if (!response.ok) {
        return {
          ok: false,
          status: response.status,
          error: body?.error || body?.message || response.statusText || 'Error HTTP',
          raw: typeof body?.raw === 'string' ? body.raw : rawBody,
        };
      }

      return body ?? { ok: true };
    }

    const api = {
      list: () => fetchJson('/api/admin/media'),
      upload: (form) => fetchJson('/api/admin/media', { method: 'POST', body: form }),
      sync: () => fetchJson('/api/admin/media?sync=1', { method: 'POST' }),
      del: (id) => fetchJson('/api/admin/media', { method: 'DELETE', headers:{'content-type':'application/json'}, body: JSON.stringify({id})}),
    };

    // DOM Elements
    const grid = document.getElementById('mediaGrid');
    const empty = document.getElementById('emptyState');
    const refreshBtn = document.getElementById('refreshBtn');
    const uploadToggle = document.getElementById('uploadToggle');
    const uploadToggleIcon = document.getElementById('uploadToggleIcon');
    const uploadBody = document.getElementById('uploadBody');
    const uploadForm = document.getElementById('uploadForm');
    const linkUploadForm = document.getElementById('linkUploadForm');
    const uploadStatus = document.getElementById('uploadStatus');
    const fileDropzone = document.getElementById('fileDropzone');
    const fileInput = document.getElementById('fileInput');
    const fileLabel = document.getElementById('fileLabel');
    const imageUrlInput = document.getElementById('imageUrlInput');
    const linkUploadBtn = document.getElementById('linkUploadBtn');
    const mediaCount = document.getElementById('mediaCount');

    // Modal elements
    const imageModal = document.getElementById('imageModal');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalClose = document.getElementById('modalClose');
    const modalImage = document.getElementById('modalImage');
    const modalTitle = document.getElementById('modalTitle');
    const infoFilename = document.getElementById('infoFilename');
    const infoSize = document.getElementById('infoSize');
    const infoType = document.getElementById('infoType');
    const infoUrl = document.getElementById('infoUrl');
    const copyUrlBtn = document.getElementById('copyUrlBtn');
    const deleteBtn = document.getElementById('deleteBtn');

    let currentMediaItem = null;

    function setUploadCollapsed(collapsed) {
      uploadBody.classList.toggle('is-collapsed', collapsed);
      uploadBody.classList.toggle('is-open', !collapsed);
      uploadToggle.setAttribute('aria-expanded', String(!collapsed));
      uploadToggleIcon.classList.toggle('fa-chevron-up', !collapsed);
      uploadToggleIcon.classList.toggle('fa-chevron-down', collapsed);
      uploadToggle.closest('.upload-card')?.classList.toggle('is-collapsed', collapsed);
    }

    uploadToggle.addEventListener('click', () => {
      const collapsed = uploadBody.classList.contains('is-collapsed');
      setUploadCollapsed(!collapsed);
    });

    function setSelectedFile(file) {
      if (!file) {
        fileLabel.textContent = 'Seleccionar imagen...';
        fileDropzone.classList.remove('has-file');
        return;
      }

      fileLabel.textContent = file.name;
      fileDropzone.classList.add('has-file');
    }

    setUploadCollapsed(true);

    // File input handling
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      setSelectedFile(file);
    });

    // Drag and drop handling
    ['dragenter', 'dragover'].forEach((eventName) => {
      fileDropzone.addEventListener(eventName, (event) => {
        event.preventDefault();
        event.stopPropagation();
        fileDropzone.classList.add('drag-active');
      });
    });

    ['dragleave', 'dragend', 'drop'].forEach((eventName) => {
      fileDropzone.addEventListener(eventName, (event) => {
        event.preventDefault();
        event.stopPropagation();
        fileDropzone.classList.remove('drag-active');
      });
    });

    fileDropzone.addEventListener('drop', (event) => {
      const file = event.dataTransfer?.files?.[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        showToast('Solo se permiten imágenes', 'warning');
        return;
      }

      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      fileInput.files = dataTransfer.files;
      setSelectedFile(file);
    });

    function updateLinkButtonState() {
      const hasUrl = imageUrlInput.value.trim().length > 0;
      linkUploadBtn.hidden = !hasUrl;
      linkUploadBtn.disabled = !hasUrl;
    }

    imageUrlInput.addEventListener('input', updateLinkButtonState);
    updateLinkButtonState();

    // Modal functions
    function openModal(item) {
      currentMediaItem = item;
      modalImage.src = item.url || item.storage_path;
      modalImage.alt = item.alt_text || '';
      modalTitle.textContent = item.filename || 'Vista previa';
      infoFilename.textContent = item.filename || 'Sin nombre';
      infoSize.textContent = formatFileSize(item.size);
      infoType.textContent = item.mime_type || 'Desconocido';
      infoUrl.value = item.url || item.storage_path;
      imageModal.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      imageModal.style.display = 'none';
      document.body.style.overflow = '';
      currentMediaItem = null;
    }

    function formatFileSize(bytes) {
      if (!bytes) return 'Desconocido';
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return Math.round(bytes / Math.pow(1024, i) * 100) / 100 + ' ' + sizes[i];
    }

    // Load media
    async function load() {
      uploadStatus.textContent = '';
      uploadStatus.className = 'upload-status';

      try {
        const res = await api.list();
        if (!res.ok) {
          uploadStatus.textContent = `Error al cargar (${res.status || 'sin status'}): ${res.error || ''}`;
          uploadStatus.classList.add('error');
          return;
        }

        const items = res.data || [];
        render(items);
      } catch (error) {
        console.error('[admin/media] load failed:', error);
        uploadStatus.textContent = 'Error de conexión al cargar medios';
        uploadStatus.classList.add('error');
      }
    }

    // Render media grid
    function render(items) {
      mediaCount.textContent = `${items.length} ${items.length === 1 ? 'imagen' : 'imágenes'}`;

      if (!items || items.length === 0) {
        grid.style.display = 'none';
        empty.style.display = 'block';
        return;
      }

      grid.style.display = 'grid';
      empty.style.display = 'none';

      grid.innerHTML = items.map(i => {
        const aspectRatio = getImageAspectRatio(i);
        const orientation = aspectRatio > 1 ? 'landscape' : 'portrait';

        return `
          <div class="media-card ${orientation}" data-id="${i.id}">
            <div class="media-thumb">
              <img src="${i.url || i.storage_path}" alt="${i.alt_text || ''}" loading="lazy" />
              <div class="media-overlay">
                <button class="preview-btn" data-id="${i.id}">
                  <i class="fas fa-eye"></i>
                </button>
                <button class="copy-btn" data-id="${i.id}">
                  <i class="fas fa-copy"></i>
                </button>
                <button class="delete-btn" data-id="${i.id}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
            <div class="media-meta">
              <div class="media-filename" title="${i.filename || ''}">${i.filename || 'Sin nombre'}</div>
              <div class="media-size">${formatFileSize(i.size)}</div>
              ${i.tags && i.tags.length > 0 ? `<div class="media-tags">${i.tags.slice(0, 2).join(', ')}${i.tags.length > 2 ? '...' : ''}</div>` : ''}
            </div>
          </div>
        `;
      }).join('');

      // Event listeners for cards
      grid.querySelectorAll('.preview-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const item = items.find(i => i.id === id);
          if (item) openModal(item);
        });
      });

      grid.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const item = items.find(i => i.id === id);
          if (item) {
            const url = item.url || item.storage_path;
            try {
              await navigator.clipboard.writeText(url);
              showToast('URL copiada al portapapeles', 'success');
            } catch {
              showToast('No se pudo copiar automáticamente', 'warning');
            }
          }
        });
      });

      grid.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const id = btn.dataset.id;
          const item = items.find(i => i.id === id);
          if (item && confirm(`¿Eliminar "${item.filename}"?`)) {
            try {
              const res = await api.del(id);
              if (res.ok) {
                showToast('Imagen eliminada', 'success');
                load();
              } else {
                showToast('Error al eliminar: ' + (res.error || ''), 'error');
              }
            } catch (error) {
              showToast('Error de conexión', 'error');
            }
          }
        });
      });

      // Click on card to preview
      grid.querySelectorAll('.media-card').forEach(card => {
        card.addEventListener('click', () => {
          const id = card.dataset.id;
          const item = items.find(i => i.id === id);
          if (item) openModal(item);
        });
      });
    }

    // Get image aspect ratio (placeholder - in real implementation you'd need image dimensions)
    function getImageAspectRatio(item) {
      // This is a simplified version. In a real implementation, you'd store dimensions
      // or calculate them from the image. For now, we'll use a default.
      return 1.5; // Assume landscape by default
    }

    // Toast notification
    function showToast(message, type = 'info') {
      // Simple toast implementation
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    // Upload form handler
    uploadForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const file = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;

      if (!file) {
        showToast('Selecciona un archivo primero', 'warning');
        return;
      }

      const form = new FormData();
      form.append('file', file);
      form.append('alt_text', document.getElementById('altInput').value || '');
      form.append('tags', document.getElementById('tagsInput').value || '');

      uploadStatus.textContent = 'Subiendo imagen...';
      uploadStatus.className = 'upload-status loading';

      try {
        const res = await api.upload(form);
        if (res.ok) {
          uploadStatus.textContent = '¡Imagen subida correctamente!';
          uploadStatus.className = 'upload-status success';
          fileInput.value = '';
          setSelectedFile(null);
          document.getElementById('altInput').value = '';
          document.getElementById('tagsInput').value = '';
          load();
        } else {
          uploadStatus.textContent = `Error al subir (${res.status || 'sin status'}): ${res.error || ''}`;
          if (res.raw) {
            console.error('[admin/media] upload response body:', res.raw);
          }
          uploadStatus.className = 'upload-status error';
        }
      } catch (error) {
        console.error('[admin/media] upload failed:', error);
        uploadStatus.textContent = 'Error de conexión al subir la imagen';
        uploadStatus.className = 'upload-status error';
      }
    });

    linkUploadForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const imageUrl = imageUrlInput.value.trim();
      if (!imageUrl) {
        showToast('Pega un enlace primero', 'warning');
        return;
      }

      const form = new FormData();
      form.append('image_url', imageUrl);
      form.append('alt_text', '');
      form.append('tags', '');

      uploadStatus.textContent = 'Descargando imagen desde enlace...';
      uploadStatus.className = 'upload-status loading';

      try {
        const res = await api.upload(form);
        if (res.ok) {
          uploadStatus.textContent = '¡Imagen agregada desde enlace correctamente!';
          uploadStatus.className = 'upload-status success';
          imageUrlInput.value = '';
          updateLinkButtonState();
          load();
        } else {
          uploadStatus.textContent = `Error al agregar (${res.status || 'sin status'}): ${res.error || ''}`;
          if (res.raw) {
            console.error('[admin/media] link upload response body:', res.raw);
          }
          uploadStatus.className = 'upload-status error';
        }
      } catch (error) {
        console.error('[admin/media] link upload failed:', error);
        uploadStatus.textContent = 'Error de conexión al agregar la imagen desde enlace';
        uploadStatus.className = 'upload-status error';
      }
    });

    // Modal event listeners
    modalBackdrop.addEventListener('click', closeModal);
    modalClose.addEventListener('click', closeModal);

    copyUrlBtn.addEventListener('click', async () => {
      if (currentMediaItem) {
        const url = currentMediaItem.url || currentMediaItem.storage_path;
        try {
          await navigator.clipboard.writeText(url);
          showToast('URL copiada al portapapeles', 'success');
        } catch {
          infoUrl.select();
          showToast('Selecciona y copia la URL manualmente', 'warning');
        }
      }
    });

    deleteBtn.addEventListener('click', async () => {
      if (currentMediaItem && confirm(`¿Eliminar "${currentMediaItem.filename}"?`)) {
        try {
          const res = await api.del(currentMediaItem.id);
          if (res.ok) {
            showToast('Imagen eliminada', 'success');
            closeModal();
            load();
          } else {
            showToast(`Error al eliminar (${res.status || 'sin status'}): ${res.error || ''}`, 'error');
            if (res.raw) {
              console.error('[admin/media] delete response body:', res.raw);
            }
          }
        } catch (error) {
          console.error('[admin/media] delete failed:', error);
          showToast('Error de conexión al eliminar', 'error');
        }
      }
    });

    // Refresh button
    refreshBtn.addEventListener('click', async () => {
      refreshBtn.disabled = true;
      refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sincronizando...';
      uploadStatus.textContent = 'Buscando imágenes en tours para recuperar medios faltantes...';
      uploadStatus.className = 'upload-status loading';

      try {
        const res = await api.sync();
        if (res.ok) {
          const created = res.data?.created ?? 0;
          const skippedExisting = res.data?.skippedExisting ?? 0;
          const skippedInvalid = res.data?.skippedInvalid ?? 0;
          uploadStatus.textContent = `Sincronización lista: ${created} recuperadas, ${skippedExisting} ya existían, ${skippedInvalid} omitidas.`;
          uploadStatus.className = 'upload-status success';
          await load();
        } else {
          uploadStatus.textContent = `Error al sincronizar (${res.status || 'sin status'}): ${res.error || ''}`;
          uploadStatus.className = 'upload-status error';
        }
      } catch (error) {
        console.error('[admin/media] sync failed:', error);
        uploadStatus.textContent = 'Error de conexión al sincronizar imágenes de tours';
        uploadStatus.className = 'upload-status error';
      } finally {
        refreshBtn.disabled = false;
        refreshBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Actualizar';
      }
    });

    // Initial load
    load();
  </script>

</AdminLayout>
