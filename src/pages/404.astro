---
import AppLayout from "../layouts/AppLayout.astro";
import { siteIdentity } from "../lib/site-config";

const title = `404 - No encontrado | ${siteIdentity.brand}`;
---

<AppLayout title={title}>
  <main class="not-found-page" aria-labelledby="not-found-title">
    <section class="not-found-card">
      <div class="not-found-code">404</div>
      <p class="not-found-kicker">Página no encontrada</p>
      <h1 id="not-found-title">No encontramos lo que buscas</h1>
      <p class="not-found-text">
        El enlace que abriste no existe, fue movido o ya no está disponible. Puedes volver al catálogo de tours para seguir navegando.
      </p>

      <div class="not-found-actions">
        <a class="not-found-button" href="/tours">Ir a Tours</a>
      </div>
    </section>
  </main>

  <style>
    .not-found-page {
      min-height: calc(100vh - 160px);
      display: grid;
      place-items: center;
      padding: 120px 20px 64px;
        background:
        radial-gradient(circle at top, rgba(131, 240, 223, 0.14), transparent 38%),
        linear-gradient(180deg, #0d1b2c 0%, #071321 100%);
    }

    .not-found-card {
      width: min(720px, 100%);
      padding: clamp(28px, 5vw, 48px);
      border-radius: 28px;
      background: rgba(19, 40, 59, 0.86);
      border: 1px solid rgba(131, 240, 223, 0.16);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.32);
      text-align: center;
      backdrop-filter: blur(14px);
    }

    .not-found-code {
      font-size: clamp(72px, 14vw, 140px);
      line-height: 0.9;
      font-weight: 900;
      letter-spacing: -0.08em;
      color: #83f0df;
      text-shadow: 0 12px 24px rgba(131, 240, 223, 0.18);
      margin-bottom: 10px;
    }

    .not-found-kicker {
      margin: 0 0 10px;
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #83f0df;
    }

    .not-found-card h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 1.05;
      color: #eef7ff;
    }

    .not-found-text {
      max-width: 56ch;
      margin: 18px auto 0;
      font-size: 1.05rem;
      line-height: 1.75;
      color: #b3c2d1;
    }

    .not-found-actions {
      margin-top: 28px;
      display: flex;
      justify-content: center;
    }

    .not-found-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 180px;
      padding: 14px 22px;
      border-radius: 14px;
      text-decoration: none;
      color: #071321;
      font-weight: 800;
      background: linear-gradient(135deg, #83f0df 0%, #4bd6c1 100%);
      box-shadow: 0 16px 28px rgba(75, 214, 193, 0.18);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .not-found-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 34px rgba(75, 214, 193, 0.24);
    }

    @media (max-width: 640px) {
      .not-found-page {
        min-height: calc(100vh - 120px);
        padding-top: 92px;
      }

      .not-found-card {
        border-radius: 22px;
      }

      .not-found-button {
        width: 100%;
      }
    }
  </style>
</AppLayout>
